.DS_Store

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# VitePress
**/.vitepress/dist/
**/.vitepress/cache/
**/.vitepress/.temp/

# Temporary files
*.tmp
.tmp/

# Generated API docs
apps/docs/api/
apps/docs/**/benchmarks.json
internal/typedoc/api/

# Environment
.env
.env.local
.env.*.local
*.local

# Local machine config (not for repo)
.npmrc

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git worktrees
.worktrees/

# Testing
coverage/
coverage-*/
.nyc_output/
*.lcov

# The distribution suites install their own deps to simulate a fresh consumer.
# pnpm-lock.yaml already covers these workspaces; the bun and deno locks are
# throwaway and no updater maintains them, so they would only drift.
internal/distribution-tests-bun/bun.lock
internal/distribution-tests-deno/deno.lock

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Turbo
.turbo/

# Changesets
.changeset/pre.json
**/CHANGELOG.md
!/CHANGELOG.md

# Test Reports
reports/

# Working docs
docs/
!apps/docs/
!apps/docs/docs/
.plans/

.worktrees
local